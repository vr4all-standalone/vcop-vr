+void model2o_state::schedule_vcop_uart_clock()
+{
+    const int level=m_uart_clock_edge&1;
+    const u64 next=m_uart_clock_edge+std::min(m_uart->idle_clock_deadline(level),m_m1audio->uart_clock_deadline(level));
+    if(next==m_uart_clock_next)return;
+    m_uart_clock_next=next;
+    m_uart_clock_timer->adjust(attotime::from_ticks(next,1000000)-machine().time());
+}
+
+void model2o_state::vcop_uart_clock_notify(bool changed)
+{
+    if(m_uart_clock_busy || !m_uart_clock_timer)return;
+    if(changed) { schedule_vcop_uart_clock();return; }
+    const u64 until=std::min(machine().time().as_ticks(1000000),m_uart_clock_next-1);
+    if(until<=m_uart_clock_edge)return;
+    const unsigned edges=until-m_uart_clock_edge;
+    const int level=m_uart_clock_edge&1;
+    m_m1audio->skip_uart_clock_edges(edges,level);m_uart->skip_idle_clock_edges(edges,level);
+    m_uart_clock_edge=until;
+}
+
+void model2o_state::vcop_uart_clock_presave()
+{
+    vcop_uart_clock_notify(false);
+}
+
+TIMER_CALLBACK_MEMBER(model2o_state::vcop_uart_clock_tick)
+{
+    m_uart_clock_busy=true;
+    const u64 event=m_uart_clock_next;
+    const unsigned skipped=event-m_uart_clock_edge-1;
+    const int previous=m_uart_clock_edge&1;
+    m_m1audio->skip_uart_clock_edges(skipped,previous);m_uart->skip_idle_clock_edges(skipped,previous);
+    m_uart_clock_edge=event;
+    vcop_uart_clock_w(event&1);
+    m_uart_clock_busy=false;
+    schedule_vcop_uart_clock();
+}
