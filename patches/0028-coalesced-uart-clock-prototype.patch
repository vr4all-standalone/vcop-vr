+unsigned i8251_device::idle_clock_deadline(int level) const
+{
+    // Fast path is limited to the observed asynchronous x16 configuration.
+    // Sync, setup, x1/x64 and incoherent pin states retain every raw edge.
+    if(m_flags!=I8251_NEXT_COMMAND || m_sync_byte_count || m_br_factor!=16 ||
+            m_txc!=level || m_rxc!=level || m_txc_count<0 || m_txc_count>=16)
+        return 1;
+    unsigned next=2u*unsigned(16-m_txc_count)-unsigned(level);
+    if(BIT(m_command,2)) {
+        if(is_receive_register_synchronized()) {
+            if(m_rxc_count<=0)return 1;
+            next=std::min(next,2u*unsigned(m_rxc_count)-1u+unsigned(level));
+        } else if(!m_rxd)next=std::min(next,1u+unsigned(level));
+    }
+    return next;
+}
+
+void i8251_device::skip_idle_clock_edges(unsigned edges,int level)
+{
+    if(!edges)return;
+    assert(edges<idle_clock_deadline(level));
+    const unsigned rising=(edges+unsigned(!level))/2;
+    const unsigned falling=(edges+unsigned(level))/2;
+    m_txc_count+=falling;
+    if(BIT(m_command,2)) {
+        if(is_receive_register_synchronized())m_rxc_count-=rising;
+        else {
+            // Idle mark pulses still shift the actual native receive register.
+            // After sixteen identical bits additional shifts are idempotent.
+            assert(m_rxd || !rising);
+            for(unsigned n=0;n<std::min(rising,16u);++n)receive_register_update_bit(1);
+        }
+    }
+    m_txc=m_rxc=level^(edges&1);
+}
