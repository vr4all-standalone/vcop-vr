+
+bool model2o_state::vcop_uart_write_fence(int source,offs_t offset,u8 data)
+{
+    if(!m_idle_uart_clock || !m_uart_clock_idle || m_uart_clock_busy)return false;
+    // Leave device state untouched until all earlier timestamped events have
+    // run. synchronize aborts the guest slice; internal pin callbacks stay raw.
+    const int transaction=(source<<9)|((offset?1:0)<<8)|data;
+    machine().scheduler().synchronize(timer_expired_delegate(FUNC(model2o_state::vcop_uart_write_commit),this),transaction);
+    return true;
+}
+
+TIMER_CALLBACK_MEMBER(model2o_state::vcop_uart_write_commit)
+{
+    vcop_uart_clock_notify(false);
+    m_uart_clock_idle=false;
+    m_uart_clock_busy=true;
+    if(param&0x200)m_m1audio->uart_write((param>>8)&1,param&0xff);
+    else m_uart->write((param>>8)&1,param&0xff);
+    m_uart_clock_busy=false;
+    // Resume on the existing global edge phase, never on now + 1us.
+    schedule_vcop_uart_clock();
+}
