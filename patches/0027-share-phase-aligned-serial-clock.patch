+        machine().save().register_postload(save_prepost_delegate(FUNC(model2o_state::restore_vcop_uart_clock),this));
+}
+
+void model2o_state::restore_vcop_uart_clock()
+{
+    // Older saved states contain an active duplicate clock. Keep its saved
+    // device layout while ensuring only the shared edge source runs.
+    auto& duplicate=*subdevice<clock_device>("uart_clock");
+    duplicate.set_unscaled_clock(0);duplicate.set_period(attotime::never);
+}
+
+void model2o_state::vcop_uart_clock_w(int state)
+{
+    m_m1audio->uart_clock_w(state);
+    m_uart->write_txc(state);
+    m_uart->write_rxc(state);
+}
